# Environment variables for AI Driver Monitor
# Copy this file to .env for local development — NEVER commit .env to Git

# Database (defaults to local SQLite if not set)
DATABASE_URL=sqlite:///driver.db

# Flask debug mode (set to "1" for local dev only)
FLASK_DEBUG=0

# ── Phase 2: Twilio (DO NOT ADD YET — placeholder only) ──────────────────
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
